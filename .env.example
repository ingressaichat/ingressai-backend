# ===== Server =====
NODE_ENV=development
PORT=8080

# ===== URLs =====
BASE_URL=http://localhost:8080
SITE_URL=https://ingressai.chat

# Vários domínios separados por vírgula (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://ingressai.chat

# ===== Meta / WhatsApp =====
GRAPH_VERSION=v20.0
WHATSAPP_TOKEN=
ACCESS_TOKEN=
WABA_TOKEN=
APP_SECRET=
PHONE_NUMBER_ID=
WA_PHONE_NUMBER_ID=
PUBLIC_WHATSAPP=

# ===== Marca/UI =====
BRAND_NAME=IngressAI
LOGO_URL=https://ingressai.chat/logo_ingressai.png

# ===== Admin / Regras =====
ADMIN_PHONES=5534999992747
TIMEZONE=America/Sao_Paulo
CURRENCY=BRL

# ===== Flags =====
ENABLE_DASHBOARD=true
ENABLE_VALIDATOR=true

# ===== Webhook =====
VERIFY_TOKEN=ingressai123

